{
  "name": "black-rhino-sdk-demo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:local": "node scripts/setup.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:https": "node --disable-warning=ExperimentalWarning --watch server/index.ts --https",
    "typecheck": "vue-tsc --noEmit",
    "check": "biome check .",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts tests/*.test.mjs",
    "tunnel": "node scripts/cloudflare.mjs start",
    "tunnel:token": "node scripts/cloudflare.mjs token",
    "tunnel:config": "node scripts/cloudflare.mjs config",
    "tunnel:check": "node scripts/cloudflare.mjs check"
  },
  "dependencies": {
    "vue": "3.5.38",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vue-tsc": "3.3.5"
  }
}
